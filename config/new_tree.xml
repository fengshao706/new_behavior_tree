<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="BulletDecision">
    <Fallback>
      <Sequence>
        <Fallback>
          <ScriptCondition code="defense_buff &lt; 30"/>
          <ScriptCondition code="ignore_buff == true"/>
        </Fallback>
        <Fallback>
          <Sequence>
            <ScriptCondition code="need_enable_fight == true"/>
            <Fallback>
              <Sequence>
                <ScriptCondition code="enable_fight == true"/>
                <ForceSuccess>
                  <SubTree ID="OutputHpBasedDecision"/>
                </ForceSuccess>
              </Sequence>
              <Sequence>
                <IsBulletsRemain/>
                <Fallback>
                  <Sequence>
                    <IsInOwnHalfArea/>
                    <Script code="enable_fight = true"/>
                  </Sequence>
                  <Sequence>
                    <Script code="enable_fight = false"/>
                    <SetChassisMode chassis_mode_id="7"/>
                  </Sequence>
                </Fallback>
              </Sequence>
              <Sequence>
                <Script code="enable_fight = true"/>
                <ForceSuccess>
                  <SubTree ID="OutputHpBasedDecision"/>
                </ForceSuccess>
              </Sequence>
            </Fallback>
          </Sequence>
          <Fallback>
            <Sequence>
              <IsBulletsRemain/>
              <Inverter>
                <IsInOwnHalfArea/>
              </Inverter>
              <SetChassisMode chassis_mode_id="7"/>
            </Sequence>
            <ForceSuccess>
              <SubTree ID="OutputHpBasedDecision"/>
            </ForceSuccess>
          </Fallback>
        </Fallback>
      </Sequence>
      <Sequence>
        <SetIsEnableFight is_enable_fight="false"/>
        <ForceSuccess>
          <SubTree ID="OutputHpBasedDecision"/>
        </ForceSuccess>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="ChassisBehavior">
    <Fallback>
      <Sequence>
        <IsRefereeOnline/>
        <Fallback>
          <Sequence>
            <IsGameInBattle/>
            <Fallback>
              <Sequence>
                <IsClientMapUpdate/>
                <GetKeyboardCommand/>
                <Switch3 case_1="0"
                         case_2="83"
                         case_3="65"
                         variable="keyboard_command">
                  <SetChassisMode chassis_mode_id="10"/>
                  <SetChassisMode chassis_mode_id="11"/>
                  <SetChassisMode chassis_mode_id="14"/>
                </Switch3>
              </Sequence>
              <Sequence>
                <ScriptCondition code="need_still_gyro == true"/>
                <SetChassisMode chassis_mode_id="15"/>
              </Sequence>
              <Sequence>
                <IsSentryHpUrgent/>
                <SetChassisMode chassis_mode_id="7"/>
              </Sequence>
              <Sequence>
                <Fallback>
                  <Sequence>
                    <Inverter>
                      <IsSupplyTaskFinished/>
                    </Inverter>
                    <SetChassisMode chassis_mode_id="7"/>
                  </Sequence>
                  <Sequence>
                    <ScriptCondition code="chassis_mode == 7"/>
                    <Inverter>
                      <IsSentryHpReturnMax/>
                    </Inverter>
                    <ScriptCondition code="defense_buff &lt; 30"/>
                    <Sequence>
                      <SetChassisMode chassis_mode_id="7"/>
                    </Sequence>
                  </Sequence>
                  <Sequence>
                    <IsNeedAvoidDrone/>
                    <SetChassisMode chassis_mode_id="16"/>
                  </Sequence>
                  <Sequence>
                    <IsNeedDefenseBase/>
                    <SetChassisMode chassis_mode_id="13"/>
                  </Sequence>
                  <ForceSuccess>
                    <SubTree ID="TimeBasedDecision"/>
                  </ForceSuccess>
                </Fallback>
              </Sequence>
            </Fallback>
          </Sequence>
          <SetChassisMode chassis_mode_id="0"/>
        </Fallback>
      </Sequence>
      <Sequence>
        <IsGameInBattle/>
        <SetChassisMode chassis_mode_id="2"/>
      </Sequence>
      <SetChassisMode chassis_mode_id="1"/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="GetEnemyInfo">
    <Sequence>
      <IsGameInBattle/>
      <Fallback>
        <Sequence _description="Tactics made when belonging to the Red team">
          <ScriptCondition code="robot_id &lt; 100"/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="GimbalBehavior">
    <Fallback>
      <Sequence>
        <IsRefereeOnline/>
        <Fallback>
          <Sequence>
            <IsGameInBattle/>
            <Fallback>
              <Sequence>
                <Inverter>
                  <IsTrackLoss/>
                </Inverter>
                <SetGimbalMode gimbal_mode_id="8"/>
              </Sequence>
              <Sequence>
                <ScriptCondition code="chassis_mode == 14"/>
                <IsReachGoal/>
                <SetGimbalMode gimbal_mode_id="7"/>
              </Sequence>
              <Sequence>
                <ScriptCondition code="chassis_mode == 5"/>
                <Fallback>
                  <Sequence>
                    <IsReachGoal/>
                    <SetGimbalMode gimbal_mode_id="6"/>
                  </Sequence>
                  <SetGimbalMode gimbal_mode_id="3"/>
                </Fallback>
              </Sequence>
              <Fallback>
                <Sequence>
                  <IsNeedInverseGimbal/>
                  <SetGimbalMode gimbal_mode_id="5"/>
                </Sequence>
                <Sequence>
                  <IsReachGoal/>
                  <SetGimbalMode gimbal_mode_id="3"/>
                </Sequence>
              </Fallback>
            </Fallback>
          </Sequence>
          <SetGimbalMode gimbal_mode_id="0"/>
        </Fallback>
      </Sequence>
      <SetGimbalMode gimbal_mode_id="1"/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <Parallel failure_count="1"
              success_count="-1">
      <SubTree ID="ChassisBehavior"/>
      <SubTree ID="GimbalBehavior"/>
      <SubTree ID="ShooterBehavior"/>
      <SubTree ID="SentryCommandSender"/>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="OutputHpBasedDecision">
    <Fallback>
      <Sequence>
        <Sequence>
          <Fallback>
            <CheckGimbalMode gimbal_mode_id="8"/>
            <Inverter>
              <IsChasePathFinished/>
            </Inverter>
          </Fallback>
          <Fallback>
            <IsOwnOutpostHpBeyondTheValue outpost_hp_threshold="310"/>
            <IsInOwnHalfArea/>
          </Fallback>
          <IsBulletsRemain/>
          <Inverter>
            <CheckTargetType track_id="6"/>
          </Inverter>
        </Sequence>
        <ForceSuccess>
          <Fallback>
            <Sequence>
              <Inverter>
                <CheckTargetType track_id="6"/>
              </Inverter>
              <Inverter>
                <CheckTargetType track_id="8"/>
              </Inverter>
              <SetChassisMode chassis_mode_id="17"/>
            </Sequence>
            <SetChassisMode chassis_mode_id="18"/>
          </Fallback>
        </ForceSuccess>
      </Sequence>
      <Fallback>
        <Sequence>
          <Inverter>
            <IsHasRevived/>
          </Inverter>
          <Fallback>
            <Sequence>
              <Sequence>
                <Fallback>
                  <IsOwnOutpostHpBeyondTheValue outpost_hp_threshold="310"/>
                  <IsEnableFight/>
                </Fallback>
                <IsBulletsRemain/>
              </Sequence>
              <Fallback>
                <Sequence>
                  <GetPresentTime present_time="{present_time}"/>
                  <ScriptCondition code="present_time &gt; 90.0"/>
                  <IsHasEngineerMarked/>
                  <ScriptCondition code="engineer_revived_times &lt;= 1"/>
                  <IsEngineerAlive/>
                  <ScriptCondition code="attack_engineer_enable == true"/>
                  <SetChassisMode chassis_mode_id="9"/>
                </Sequence>
                <Sequence>
                  <IsOutpostAlive/>
                  <GetPresentTime present_time="{present_time}"/>
                  <ScriptCondition code="present_time &gt; 50.0 &amp;&amp; present_time &lt; 90.0"/>
                  <ScriptCondition code="attack_outpost_enable == true"/>
                  <SetChassisMode chassis_mode_id="5"/>
                </Sequence>
                <SetChassisMode chassis_mode_id="3"/>
              </Fallback>
            </Sequence>
            <Sequence>
              <Fallback>
                <Sequence>
                  <GetPresentTime present_time="{present_time}"/>
                  <ScriptCondition code="present_time &gt; 240.0"/>
                  <Fallback>
                    <Sequence>
                      <ScriptCondition code="enable_hole_up == true"/>
                      <IsSentryHpUrgent/>
                      <SetChassisMode chassis_mode_id="8"/>
                    </Sequence>
                    <Sequence>
                      <IsBulletsRemain/>
                      <SetChassisMode chassis_mode_id="4"/>
                    </Sequence>
                    <SetChassisMode chassis_mode_id="6"/>
                  </Fallback>
                </Sequence>
                <Fallback>
                  <Sequence>
                    <ScriptCondition code="enable_hole_up == true"/>
                    <IsSentryHpUrgent/>
                    <SetChassisMode chassis_mode_id="8"/>
                  </Sequence>
                  <SetChassisMode chassis_mode_id="6"/>
                </Fallback>
              </Fallback>
            </Sequence>
          </Fallback>
        </Sequence>
        <SetChassisMode chassis_mode_id="12"/>
      </Fallback>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="SendManualCmd">
    <Sequence>
      <StopAutoController/>
      <SendManualCommand/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SentryCommandSender">
    <Parallel failure_count="1"
              success_count="-1">
      <ReactiveFallback>
        <Switch6 case_1="0"
                 case_2="1"
                 case_3="2"
                 case_4="3"
                 case_5="4"
                 case_6="5"
                 variable="chassis_mode">
          <ChassisSlowGyro still_gyro_vel="{slow_gyro_vel}"/>
          <AbnormalStillStopMotion/>
          <PatrolAbnormalBackHomeGoal/>
          <PatrolAttackEnemyPositiveArea/>
          <PatrolOwnOutpostArea/>
          <GotoEnemyOutpost/>
        </Switch6>
        <Switch6 case_1="6"
                 case_2="7"
                 case_3="8"
                 case_4="10"
                 case_5="11"
                 case_6="12"
                 variable="chassis_mode">
          <PatrolSentryPatrolArea/>
          <GotoReturnBloodArea/>
          <PatrolHoleUpArea/>
          <GotoConductPoint/>
          <GotoConductPoint/>
          <PatrolAfterRevivePatrolArea/>
        </Switch6>
        <Switch6 case_1="13"
                 case_2="14"
                 case_3="15"
                 case_4="16"
                 case_5="17"
                 case_6="18"
                 variable="chassis_mode">
          <GotoBaseDefenseArea/>
          <GotoEnemyBaseArea/>
          <SetGyroInCombat/>
          <PatrolSentryPatrolArea/>
          <ChaseEnemy/>
          <SetGyroInCombat/>
        </Switch6>
        <ReactiveSequence>
          <ScriptCondition code="chassis_mode == 9"/>
          <GotoAttackEnemyEngineer/>
        </ReactiveSequence>
      </ReactiveFallback>
      <ReactiveFallback>
        <Switch6 case_1="0"
                 case_2="1"
                 case_3="2"
                 case_4="3"
                 case_5="5"
                 case_6="6"
                 variable="gimbal_mode">
          <YawSlowRound/>
          <AbnormalStillStopMotion/>
          <LidarTowardsFront/>
          <RoundSearchEnemy/>
          <InverseGimbal/>
          <AimOutpost/>
        </Switch6>
        <Switch2 case_1="7"
                 case_2="8"
                 variable="gimbal_mode">
          <AimBase/>
          <TrackEnemy/>
        </Switch2>
      </ReactiveFallback>
      <ReactiveFallback>
        <Switch3 case_1="0"
                 case_2="1"
                 case_3="2"
                 variable="shooter_mode">
          <ShooterStop/>
          <ShooterReady/>
          <ShooterPush/>
        </Switch3>
      </ReactiveFallback>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="SetIdle">
    <Sequence>
      <StartMainControllers/>
      <Calibrate/>
      <VisionCalibrate/>
      <SetGyroInCombat/>
      <SetChassisMode chassis_mode_id=""/>
      <SetChassisCommandSourceFrame/>
      <SendChassisCommand/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ShooterBehavior">
    <Fallback>
      <Sequence>
        <IsRefereeOnline/>
        <Fallback>
          <Sequence>
            <IsGameInBattle/>
            <Fallback>
              <Sequence>
                <ScriptCondition code="gimbal_mode == 8"/>
                <IsTargetEffective/>
                <IsTargetNotInvincible/>
                <SetShooterMode shooter_mode_id="2"/>
              </Sequence>
              <SetShooterMode shooter_mode_id="1"/>
            </Fallback>
          </Sequence>
          <SetShooterMode shooter_mode_id="1"/>
        </Fallback>
      </Sequence>
      <SetShooterMode shooter_mode_id="0"/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="TimeBasedDecision">
    <Fallback>
      <Sequence>
        <GetPresentTime present_time="{present_time}"/>
        <ScriptCondition code="present_time &gt; 120.0"/>
        <Fallback>
          <Sequence>
            <GetPresentTime present_time="{present_time}"/>
            <ScriptCondition code="present_time &gt; 158.0"/>
            <Sequence>
              <Script code="enable_hole_up = false"/>
            </Sequence>
            <Fallback>
              <Sequence>
                <GetPresentTime present_time="{present_time}"/>
                <ScriptCondition code="present_time &gt; 230.0"/>
                <Fallback>
                  <Sequence>
                    <GetPresentTime present_time="{present_time}"/>
                    <ScriptCondition code="present_time &gt; 270.0"/>
                    <Fallback>
                      <Sequence>
                        <GetPresentTime present_time="{present_time}"/>
                        <ScriptCondition code="present_time &gt; 300.0"/>
                        <Sequence>
                          <Script code="need_enable_fight = false"/>
                          <Script code="ignore_buff = true"/>
                          <ForceSuccess>
                            <SubTree ID="BulletDecision"
                                     need_enable_fight="{need_enable_fight}"
                                     ignore_buff="{ignore_buff}"/>
                          </ForceSuccess>
                        </Sequence>
                      </Sequence>
                      <Sequence>
                        <Script code="need_enable_fight = false"/>
                        <Script code="ignore_buff = false"/>
                        <ForceSuccess>
                          <SubTree ID="BulletDecision"
                                   need_enable_fight="{need_enable_fight}"
                                   ignore_buff="{ignore_buff}"/>
                        </ForceSuccess>
                      </Sequence>
                    </Fallback>
                  </Sequence>
                  <Sequence>
                    <Script code="enable_fight = false"/>
                    <Script code="need_enable_fight = false"/>
                    <Script code="ignore_buff = false"/>
                    <ForceSuccess>
                      <SubTree ID="BulletDecision"
                               need_enable_fight="{need_enable_fight}"
                               ignore_buff="{ignore_buff}"/>
                    </ForceSuccess>
                  </Sequence>
                </Fallback>
              </Sequence>
              <Sequence>
                <Script code="need_enable_fight = true"/>
                <Script code="ignore_buff = true"/>
                <ForceSuccess>
                  <SubTree ID="BulletDecision"
                           need_enable_fight="{need_enable_fight}"
                           ignore_buff="{ignore_buff}"/>
                </ForceSuccess>
              </Sequence>
            </Fallback>
          </Sequence>
          <Sequence>
            <Script code="need_enable_fight = false"/>
            <Script code="ignore_buff = false"/>
            <ForceSuccess>
              <SubTree ID="BulletDecision"
                       need_enable_fight="{need_enable_fight}"
                       ignore_buff="{ignore_buff}"/>
            </ForceSuccess>
          </Sequence>
        </Fallback>
      </Sequence>
      <Sequence>
        <Script code="enable_hole_up = true"/>
        <SubTree ID="OutputHpBasedDecision"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="manual">
    <Sequence>
      <ManualSendChassisCmd/>
      <ManualSendGimbalCmd/>
      <ManualSendShooterCmd/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AbnormalStillStopMotion"
            editable="true"/>
    <Action ID="AimBase"
            editable="true"/>
    <Action ID="AimOutpost"
            editable="true"/>
    <SubTree ID="BulletDecision"
             editable="true">
      <input_port name="need_enable_fight"
                  default="{need_enable_fight}"
                  type="bool"/>
      <input_port name="ignore_buff"
                  default="{ignore_buff}"
                  type="bool"/>
    </SubTree>
    <Action ID="Calibrate"
            editable="true"/>
    <Action ID="ChaseEnemy"
            editable="true"/>
    <Action ID="ChassisSlowGyro"
            editable="true">
      <input_port name="still_gyro_vel"
                  default="{slow_gyro_vel}"
                  type="double"/>
    </Action>
    <Condition ID="CheckGimbalMode"
               editable="true">
      <input_port name="gimbal_mode_id"
                  type="int"/>
    </Condition>
    <Condition ID="CheckTargetType"
               editable="true">
      <input_port name="track_id"
                  type="int"/>
    </Condition>
    <Action ID="GetKeyboardCommand"
            editable="true"/>
    <Action ID="GetPresentTime"
            editable="true">
      <output_port name="present_time"
                   type="double"/>
    </Action>
    <Action ID="GotoAttackEnemyEngineer"
            editable="true"/>
    <Action ID="GotoBaseDefenseArea"
            editable="true"/>
    <Action ID="GotoConductPoint"
            editable="true"/>
    <Action ID="GotoEnemyBaseArea"
            editable="true"/>
    <Action ID="GotoEnemyOutpost"
            editable="true"/>
    <Action ID="GotoReturnBloodArea"
            editable="true"/>
    <Action ID="InverseGimbal"
            editable="true"/>
    <Condition ID="IsBulletsRemain"
               editable="true"/>
    <Condition ID="IsChasePathFinished"
               editable="true"/>
    <Condition ID="IsClientMapUpdate"
               editable="true"/>
    <Condition ID="IsEnableFight"
               editable="true"/>
    <Condition ID="IsEngineerAlive"
               editable="true"/>
    <Condition ID="IsGameInBattle"
               editable="true"/>
    <Condition ID="IsHasEngineerMarked"
               editable="true"/>
    <Condition ID="IsHasRevived"
               editable="true"/>
    <Condition ID="IsInOwnHalfArea"
               editable="true"/>
    <Condition ID="IsNeedAvoidDrone"
               editable="true"/>
    <Condition ID="IsNeedDefenseBase"
               editable="true"/>
    <Condition ID="IsNeedInverseGimbal"
               editable="true"/>
    <Condition ID="IsOutpostAlive"
               editable="true"/>
    <Condition ID="IsOwnOutpostHpBeyondTheValue"
               editable="true">
      <input_port name="outpost_hp_threshold"
                  type="int"/>
    </Condition>
    <Condition ID="IsReachGoal"
               editable="true"/>
    <Condition ID="IsRefereeOnline"
               editable="true"/>
    <Condition ID="IsSentryHpReturnMax"
               editable="true"/>
    <Condition ID="IsSentryHpUrgent"
               editable="true"/>
    <Condition ID="IsSupplyTaskFinished"
               editable="true"/>
    <Condition ID="IsTargetEffective"
               editable="true"/>
    <Condition ID="IsTargetNotInvincible"
               editable="true"/>
    <Condition ID="IsTrackLoss"
               editable="true"/>
    <Action ID="LidarTowardsFront"
            editable="true"/>
    <Action ID="ManualSendChassisCmd"
            editable="true"/>
    <Action ID="ManualSendGimbalCmd"
            editable="true"/>
    <Action ID="ManualSendShooterCmd"
            editable="true"/>
    <Action ID="PatrolAbnormalBackHomeGoal"
            editable="true"/>
    <Action ID="PatrolAfterRevivePatrolArea"
            editable="true"/>
    <Action ID="PatrolAttackEnemyPositiveArea"
            editable="true"/>
    <Action ID="PatrolHoleUpArea"
            editable="true"/>
    <Action ID="PatrolOwnOutpostArea"
