<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="mainTree">
  <BehaviorTree ID="auto">
    <ReactiveIfThenElse>
      <IsGameInBattle/>
      <Parallel failure_count="1"
                success_count="-1">
        <ReactiveSequence>
          <Sequence>
            <ReviveIfDead self_is_weak="{self_is_weak}"
                          self_weak_until="{self_weak_until}"
                          need_supply="{need_supply}"
                          has_revived="{has_revived}"
                          confirm_respawn="{confirm_respawn}"/>
            <RelieveWeakState need_supply="{need_supply}"
                              chassis_mode="{chassis_mode}"
                              need_supply_output="{need_supply}"/>
          </Sequence>
          <Inverter>
            <IsClientMapUpdate chassis_mode="{chassis_mode}"/>
          </Inverter>
          <ReactiveIfThenElse>
            <Fallback>
              <IsSentryHpUrgent trigger_blood_return_hp="30"/>
              <Inverter>
                <IsBulletsRemain is_need_get_bullet="{is_need_get_bullet}"/>
              </Inverter>
            </Fallback>
            <GotoReturnBloodArea is_need_get_bullet="{is_need_get_bullet}"/>
            <AlwaysSuccess/>
          </ReactiveIfThenElse>
          <SubTree ID="timeBasedDecision"
                   _autoremap="true"/>
        </ReactiveSequence>
        <SubTree ID="gimbal_behavior"
                 _autoremap="true"/>
        <SubTree ID="shooter_behavior"
                 _autoremap="true"/>
      </Parallel>
      <Parallel failure_count="1"
                success_count="-1">
        <ChassisSlowGyro slow_gyro_vel_scale="0.2"/>
        <YawSlowRound yaw_vel="2.0"
                      scan_range_circles="3"
                      pitch_inside_vel="2.0"
                      pitch_outside_vel="3.0"
                      pitch_min="-0.55"
                      pitch_max="0.55"
                      breach_thresholds="0.1"/>
        <ShooterReady/>
      </Parallel>
    </ReactiveIfThenElse>
  </BehaviorTree>

  <BehaviorTree ID="gimbal_behavior">
    <Parallel failure_count="1"
              success_count="-1">
      <UpdateAimPriority chassis_mode="{chassis_mode}"
                         robot_color="{robot_color}"
                         aim_priority="{aim_priority}"/>
      <ReactiveIfThenElse>
        <Script code="is_need_aim_outpost==true"/>
        <ReactiveIfThenElse>
          <IsTargetEffective/>
          <TrackEnemy/>
          <PreAimingOutpost robot_color="{robot_color}"
                            aim_per_point_sec="{aim_per_point_sec}"
                            blue_outpost_poses="{blue_outpost_poses}"
                            red_outpost_poses="{red_outpost_poses}"/>
        </ReactiveIfThenElse>
        <ReactiveIfThenElse>
          <Script code="is_need_aim_base==true"/>
          <ReactiveIfThenElse>
            <IsTargetEffective/>
            <TrackEnemy/>
            <PreAimingBase robot_color="{robot_color}"
                           aim_per_point_sec="{aim_per_point_sec}"
                           blue_base_poses="{blue_base_poses}"
                           red_base_poses="{red_base_poses}"/>
          </ReactiveIfThenElse>
          <ReactiveIfThenElse>
            <IsNeedInverseGimbal default_aim_rank="{default_aim_rank}"/>
            <RunForSeconds seconds="1.0">
              <InverseGimbal/>
            </RunForSeconds>
            <ReactiveIfThenElse>
              <IsTargetEffective/>
              <TrackEnemy/>
              <YawSlowRound yaw_vel="2.0"
                            scan_range_circles="3"
                            pitch_inside_vel="2.0"
                            pitch_outside_vel="3.0"
                            pitch_min="-0.55"
                            pitch_max="0.55"
                            breach_thresholds="0.1"/>
            </ReactiveIfThenElse>
          </ReactiveIfThenElse>
        </ReactiveIfThenElse>
      </ReactiveIfThenElse>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="mainTree">
    <ReactiveSequence>
      <ReactiveFallback>
        <IsRemoteControlTurnOn/>
        <RemoteControlTurnOff/>
      </ReactiveFallback>
      <IfThenElse>
        <ForceSuccess>
          <IsRefereeOnline/>
        </ForceSuccess>
        <RunOnce then_skip="true">
          <VisionCalibrate robot_color="{robot_color}"/>
        </RunOnce>
        <AlwaysFailure/>
      </IfThenElse>
      <OutputRightSwitchState state="{state}"/>
      <Switch3 case_1="auto"
               case_2="manual"
               case_3="idle"
               variable="{state}">
        <SequenceWithMemory>
          <StartStateControllers/>
          <StartMainControllers/>
          <Sequence>
            <SetControlModes chassis_mode="raw"
                             gimbal_mode="traj"
                             shooter_mode="stop"/>
            <Parallel failure_count="1"
                      success_count="-1">
              <YawSlowRound yaw_vel="0.4"
                            scan_range_circles="2"
                            pitch_inside_vel="0.4"
                            pitch_outside_vel="0.6"
                            pitch_min="-0.05"
                            pitch_max="0.259"
                            breach_thresholds="0.1"/>
              <ReactiveSequence>
                <ReactiveIfThenElse>
                  <IsRobotInArea area_name="road_area"/>
                  <AlignToRoadAreaYaw road_area_align_yaw="{road_area_align_yaw}"
                                      road_area_align_yaw_tolerance="{road_area_align_yaw_tolerance}"
                                      road_area_align_angular_vel="{road_area_align_angular_vel}"
                                      road_area_align_timeout="{road_area_align_timeout}"/>
                  <AlwaysSuccess/>
                </ReactiveIfThenElse>
                <ReactiveIfThenElse>
                  <IsSentryHpUrgent trigger_blood_return_hp="50"/>
                  <GotoReturnBloodArea is_need_get_bullet="false"/>
                  <PatrolTestArea/>
                </ReactiveIfThenElse>
              </ReactiveSequence>
            </Parallel>
          </Sequence>
        </SequenceWithMemory>
        <SequenceWithMemory>
          <StartMainControllers/>
          <StartStateControllers/>
          <Parallel failure_count="1"
                    success_count="-1">
            <ManualSendChassisCmd/>
            <ManualSendGimbalCmd/>
            <ManualSendShooterCmd/>
          </Parallel>
        </SequenceWithMemory>
        <SetIdle/>
        <SetIdle/>
      </Switch3>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="shooter_behavior">
    <ReactiveIfThenElse>
      <IsTargetEffective/>
      <ShooterPush/>
      <ShooterReady/>
    </ReactiveIfThenElse>
  </BehaviorTree>

  <BehaviorTree ID="timeBasedDecision">
    <ReactiveSequence>
      <ReactiveIfThenElse>
        <IsTimeRangeCondition min_time="0"
                              max_time="120"
                              game_total_time="420"/>
        <ReactiveIfThenElse>
          <IsOutpostAlive/>
          <Sequence>
            <PatrolEnemyOutpostArea robot_color="{robot_color}"/>
            <Script code="is_need_aim_outpost:=true"/>
          </Sequence>
          <Sequence>
            <Script code="is_need_aim_outpost:=false"/>
            <GotoTrapezoidArea robot_color="{robot_color}"/>
          </Sequence>
        </ReactiveIfThenElse>
        <Sequence>
          <Script code="is_need_aim_outpost:=false"/>
          <AlwaysSuccess/>
        </Sequence>
      </ReactiveIfThenElse>
      <ReactiveIfThenElse>
        <IsOutpostAlive/>
        <PatrolSentryPatrolArea robot_color="{robot_color}"/>
        <ReactiveIfThenElse>
          <Fallback>
            <IsOwnFortressBeenCap capture_status="2"/>
            <IsOwnFortressBeenCap capture_status="3"/>
          </Fallback>
          <GotoBaseDefenceArea robot_color="{robot_color}"/>
          <ReactiveIfThenElse>
            <IsHeroInTrapezoid/>
            <GotoTrapezoidArea robot_color="{robot_color}"/>
            <ReactiveIfThenElse>
              <IsOwnFortressBeenCap capture_status="1"/>
              <PatrolSentryPatrolArea robot_color="{robot_color}"/>
              <GotoOwnFortress robot_color="{robot_color}"/>
            </ReactiveIfThenElse>
          </ReactiveIfThenElse>
        </ReactiveIfThenElse>
      </ReactiveIfThenElse>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AlignToRoadAreaYaw"
            editable="true">
      <input_port name="road_area_align_yaw"
                  default="{road_area_align_yaw}"
                  type="double"/>
      <input_port name="road_area_align_yaw_tolerance"
                  default="{road_area_align_yaw_tolerance}"
                  type="double"/>
      <input_port name="road_area_align_angular_vel"
                  default="{road_area_align_angular_vel}"
                  type="double"/>
      <input_port name="road_area_align_timeout"
                  default="{road_area_align_timeout}"
                  type="double"/>
    </Action>
    <Action ID="ChassisSlowGyro"
            editable="true">
      <input_port name="slow_gyro_vel_scale"
                  type="double"/>
    </Action>
    <Action ID="GotoBaseDefenceArea"
            editable="true">
      <input_port name="robot_color"
                  default="{robot_color}"
                  type="std::string"/>
    </Action>
    <Action ID="GotoOwnFortress"
            editable="true">
      <input_port name="robot_color"
                  default="{robot_color}"
                  type="std::string"/>
    </Action>
    <Action ID="GotoReturnBloodArea"
            editable="true">
      <input_port name="is_need_get_bullet"
                  default="{is_need_get_bullet}"
                  type="bool"/>
    </Action>
    <Action ID="GotoTrapezoidArea"
            editable="true">
      <input_port name="robot_color"
                  default="{robot_color}"
                  type="std::string"/>
    </Action>
    <Action ID="InverseGimbal"
            editable="true"/>
    <Condition ID="IsBulletsRemain"
               editable="true">
      <output_port name="is_need_get_bullet"
                   default="{is_need_get_bullet}"
                   type="bool"/>
    </Condition>
    <Condition ID="IsClientMapUpdate"
               editable="true">
      <output_port name="chassis_mode"
                   default="{chassis_mode}"
                   type="int"/>
    </Condition>
    <Condition ID="IsGameInBattle"
               editable="true"/>
    <Condition ID="IsHeroInTrapezoid"
               editable="true"/>
    <Condition ID="IsNeedInverseGimbal"
               editable="true">
      <input_port name="default_aim_rank"
                  default="{default_aim_rank}"
                  type="std::vector&lt;int&gt;"/>
    </Condition>
    <Condition ID="IsOutpostAlive"
               editable="true"/>
    <Condition ID="IsOwnFortressBeenCap"
               editable="true">
      <input_port name="capture_status"
                  type="int"/>
    </Condition>
    <Condition ID="IsRefereeOnline"
               editable="true"/>
    <Condition ID="IsRemoteControlTurnOn"
               editable="true"/>
    <Condition ID="IsRobotInArea"
               editable="true">
      <input_port name="area_name"
                  type="std::string"/>
    </Condition>
    <Condition ID="IsSentryHpUrgent"
               editable="true">
      <input_port name="trigger_blood_return_hp"
                  type="int"/>
    </Condition>
    <Condition ID="IsTargetEffective"
               editable="true"/>
    <Condition ID="IsTimeRangeCondition"
               editable="true">
      <input_port name="min_time"
                  type="double"/>
      <input_port name="max_time"
                  type="double"/>
      <input_port name="game_total_time"
                  type="double"/>
    </Condition>
    <Action ID="ManualSendChassisCmd"
            editable="true"/>
    <Action ID="ManualSendGimbalCmd"
            editable="true"/>
    <Action ID="ManualSendShooterCmd"
            editable="true"/>
    <Action ID="OutputRightSwitchState"
            editable="true">
      <output_port name="state"
                   default="{state}"
                   type="std::string"/>
    </Action>
    <Action ID="PatrolEnemyOutpostArea"
            editable="true">
      <input_port name="robot_color"
                  default="{robot_color}"
                  type="std::string"/>
    </Action>
    <Action ID="PatrolSentryPatrolArea"
            editable="true">
      <input_port name="robot_color"
                  default="{robot_color}"
                  type="std::string"/>
    </Action>
    <Action ID="PatrolTestArea"
            editable="true"/>
    <Action ID="PreAimingBase"
            editable="true">
      <input_port name="robot_color"
                  default="{robot_color}"
                  type="std::string"/>
      <input_port name="aim_per_point_sec"
                  default="{aim_per_point_sec}"
                  type="double"/>
      <input_port name="blue_base_poses"
                  default="{blue_base_poses}"
                  type="std::vector&lt;geometry_msgs::PointStamped&gt;"/>
      <input_port name="red_base_poses"
                  default="{red_base_poses}"
                  type="std::vector&lt;geometry_msgs::PointStamped&gt;"/>
    </Action>
    <Action ID="PreAimingOutpost"
            editable="true">
      <input_port name="robot_color"
                  default="{robot_color}"
                  type="std::string"/>
      <input_port name="aim_per_point_sec"
                  default="{aim_per_point_sec}"
                  type="double"/>
      <input_port name="blue_outpost_poses"
                  default="{blue_outpost_poses}"
                  type="std::vector&lt;geometry_msgs::PointStamped&gt;"/>
      <input_port name="red_outpost_poses"
                  default="{red_outpost_poses}"
                  type="std::vector&lt;geometry_msgs::PointStamped&gt;"/>
    </Action>
    <Control ID="ReactiveIfThenElse"
             editable="true"/>
    <Action ID="RelieveWeakState"
            editable="true">
      <input_port name="need_supply"
                  default="{need_supply}"
                  type="bool"/>
      <output_port name="chassis_mode"
                   default="{chassis_mode}"
                   type="int"/>
      <output_port name="need_supply_output"
                   default="{need_supply}"
                   type="bool"/>
    </Action>
    <Action ID="RemoteControlTurnOff"
            editable="true"/>
    <Action ID="ReviveIfDead"
            editable="true">
      <output_port name="self_is_weak"
                   default="{self_is_weak}"
                   type="bool"/>
      <output_port name="self_weak_until"
                   default="{self_weak_until}"
                   type="ros::Time"/>
      <output_port name="need_supply"
                   default="{need_supply}"
                   type="bool"/>
      <output_port name="has_revived"
                   default="{has_revived}"
                   type="bool"/>
      <output_port name="confirm_respawn"
                   default="{confirm_respawn}"
                   type="bool"/>
    </Action>
    <Decorator ID="RunForSeconds"
               editable="true">
      <input_port name="seconds"
                  type="double"/>
    </Decorator>
    <Action ID="SetControlModes"
            editable="true">
      <input_port name="chassis_mode"
                  type="std::string"/>
      <input_port name="gimbal_mode"
                  type="std::string"/>
      <input_port name="shooter_mode"
                  type="std::string"/>
    </Action>
    <Action ID="SetIdle"
            editable="true"/>
    <Action ID="ShooterPush"
            editable="true"/>
    <Action ID="ShooterReady"
            editable="true"/>
    <Action ID="StartMainControllers"
            editable="true"/>
    <Action ID="StartStateControllers"
            editable="true"/>
    <Action ID="TrackEnemy"
            editable="true"/>
    <Action ID="UpdateAimPriority"
            editable="true">
      <input_port name="chassis_mode"
                  default="{chassis_mode}"
                  type="int"/>
      <input_port name="robot_color"
                  default="{robot_color}"
                  type="std::string"/>
      <output_port name="aim_priority"
                   default="{aim_priority}"
                   type="std::vector&lt;uint_8&gt;"/>
    </Action>
    <Action ID="VisionCalibrate"
            editable="true">
      <input_port name="robot_color"
                  default="{robot_color}"
                  type="std::string"/>
    </Action>
    <Action ID="YawSlowRound"
            editable="true">
      <input_port name="yaw_vel"
                  type="double"/>
      <input_port name="scan_range_circles"
                  type="double"/>
      <input_port name="pitch_inside_vel"
                  type="double"/>
      <input_port name="pitch_outside_vel"
                  type="double"/>
      <input_port name="pitch_min"
                  type="double"/>
      <input_port name="pitch_max"
                  type="double"/>
      <input_port name="breach_thresholds"
                  type="double"/>
    </Action>
  </TreeNodesModel>

</root>
